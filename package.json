{
  "name": "dsh-tray-restart",
  "version": "0.2.1",
  "description": "把「重启 DeepSeek Harness」加进 Windows 桌面端现有的托盘/应用菜单（补丁 app.asar 的 lib/main.js，重启后生效）。",
  "icon": "icon.png",
  "author": "hxh230802",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxh230802/dsh-tray-restart.git"
  },
  "homepage": "https://github.com/hxh230802/dsh-tray-restart",
  "bugs": {
    "url": "https://github.com/hxh230802/dsh-tray-restart/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "scripts",
    "icon.png",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tray",
    "restart",
    "menu"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
